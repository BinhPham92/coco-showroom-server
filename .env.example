# Copy to .env and fill in values. Never commit .env.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_USER=cocoshowroom
DB_PASSWORD=changeme

# ── CORS — comma-separated list of allowed frontend origins ─────────────────
CORS_ORIGINS=http://localhost:3031

# ── JWT — must be ≥ 32 random characters in production ─────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# ── Storage — base URL prepended to image keys ──────────────────────────────
# Local dev: Next.js dev server (images live in public/assets/)
# Production: your CDN origin, e.g. https://cdn.cocoshowroom.vn
STORAGE_BASE_URL=http://localhost:3031

# ── Admin account — seeded on first boot if the email doesn't exist ─────────
# Change both values before going to production.
ADMIN_EMAIL=admin@cocoshowroom.vn
ADMIN_PASSWORD=changeme
